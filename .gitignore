# Ignore input rasters, processing staging, and generated outputs
input/*
!input/.gitkeep

processing/*
!processing/.gitkeep

output/*
!output/.gitkeep

# Raw raster and archive formats
*.TIF
*.tif
*.tiff
*.img
*.rrd
*.ige
*.ovr
*.aux
*.aux.xml
*.tar
*.tar.gz
*.tgz
*.rar
*.zip
*.7z

# Python cache & OS artifacts
__pycache__/
*.pyc
.DS_Store
Thumbs.db
